# LottoPH Today — Apache rules for SiteGround (static Astro output + small PHP live layer)

# Force HTTPS and non-www (adjust if you prefer www)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old alias: /today/ is the homepage (permanent, KB 04 §7)
RewriteRule ^today/?$ / [L,R=301]

# Directory-style URLs with trailing slash (Astro build.format = directory)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Custom 404
ErrorDocument 404 /404.html

# Never serve the live layer's config or logs
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/api/data/

# Caching: HTML short (results change), JSON very short, assets long (hashed by Astro)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=120, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=60, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|avif|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HSTS (KB 04 §8): enable only after HTTPS works on the live domain; no preload / includeSubDomains yet.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
# /js/live.js and /live/latest.json must not be cached long
<Files "live.js">
  Header set Cache-Control "public, max-age=300"
</Files>
<Files "latest.json">
  Header set Cache-Control "no-cache"
</Files>

AddDefaultCharset UTF-8
